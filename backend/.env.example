# Copy to .env and fill in with real values. Never commit .env.

# Encrypts SMB volume passwords at rest in the Postgres index — required.
# Generate one with: openssl rand -base64 32
# Losing this key means every stored volume password must be re-entered;
# there's no way to recover them without it.
FINDO_MASTER_KEY=changeme-generate-with-openssl-rand-base64-32

# Where to listen. The default is this machine only. People sign in with
# passkeys, which browsers only allow over HTTPS (or on localhost), so reach
# Findo through a TLS proxy such as Caddy in front of this address rather than
# by widening it (HTTP_ADDR=:8080 serves plain HTTP to your network).
HTTP_ADDR=127.0.0.1:8080

# The address people use to reach Findo, e.g. https://findo.example.com. Passkeys
# are bound to its host name, so settle it before anyone enrolls: changing it
# means everyone enrolls again. Plain http is accepted only for localhost, which
# is the default and works only in a browser on this machine. Its host is
# allowed automatically; no need to repeat it in FINDO_ALLOWED_HOSTS.
# FINDO_PUBLIC_URL=https://findo.example.com

# Extra names Findo may be reached by, beyond localhost, IP addresses, and local
# names (*.local, *.lan, single-label names, this Mac's hostname). Only needed for
# something like a Tailscale name or a reverse proxy.
# FINDO_ALLOWED_HOSTS=findo.tail1234.ts.net
# Postgres connection string. The default is the local server on its Unix
# socket, database "findo" (created by deploy/macos/install.sh).
DATABASE_URL=postgres:///findo

# SMB volumes (host/share/credentials) aren't configured here — add them at
# runtime via the dashboard or POST /volumes once the server is running.
